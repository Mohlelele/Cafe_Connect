{
  "name": "cafe-connect",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "node --test \"lib/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "db:apply": "prisma db execute --file prisma/database/migrations/20261110150000_menu_details.sql && prisma db execute --file prisma/database/migrations/20261110160000_staff_requests.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
