# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Needed for the admin Students tools. Never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Used by Prisma for all app data.
# Supabase dashboard > Connect > Transaction pooler (port 6543).
# Keep the two options on the end: Supabase's certificate is not in Node's trust store.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true

# Server only. Emails such as "your order is ready" are sent through Resend.
# Add these two to Vercel too. Without them the app works but sends no emails.
# resend.com > API Keys (Sending access)
RESEND_API_KEY=
# An address on the domain you verified in Resend, e.g. no-reply@yourdomain.co.za
EMAIL_FROM=

# The site's public address, used for links and the logo in emails.
# On Vercel set it to your live address, e.g. https://cafe-connect.vercel.app
SITE_URL=

# Only for `npm run setup:supabase`. Keep it on your computer, not in Vercel.
# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
